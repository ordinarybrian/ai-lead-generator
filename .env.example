# Copy this file to .env and fill in real values. .env is gitignored and never committed.
# Used by scripts/clickup_sync.py to sync leads/lead-index.csv into a ClickUp List.

# ClickUp personal API token. Find it at:
# ClickUp -> Settings -> Apps -> API Token (starts with "pk_")
CLICKUP_API_TOKEN=pk_your_token_here

# Target List ID for the sync. Find it via the ClickUp List's URL
# (https://app.clickup.com/<team>/v/li/<LIST_ID>) or the MCP
# clickup_get_workspace_hierarchy tool.
CLICKUP_LIST_ID=your_list_id_here
